{
  "name": "site-to-api",
  "type": "module",
  "version": "0.1.3",
  "description": "Capture a website's traffic once and get OpenAPI specs, request flows and a typed client that a coding agent can build a wrapper from.",
  "author": "Jatin <agrawaljatin22@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jatinag22/site-to-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinag22/site-to-api.git",
    "directory": "packages/site-to-api"
  },
  "bugs": "https://github.com/jatinag22/site-to-api/issues",
  "keywords": [
    "api",
    "openapi",
    "asyncapi",
    "reverse-engineering",
    "internal-api",
    "unofficial-api",
    "api-discovery",
    "har",
    "network-capture",
    "websocket",
    "graphql",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "zod",
    "codegen",
    "playwright",
    "sourcemap",
    "ai-agents",
    "claude-code",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "site-to-api": "./bin/site-to-api.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "catalog:prod",
    "@hey-api/shared": "catalog:prod",
    "@jridgewell/trace-mapping": "catalog:prod",
    "@modelcontextprotocol/server": "catalog:prod",
    "commander": "catalog:prod",
    "consola": "catalog:prod",
    "css-select": "catalog:prod",
    "domhandler": "catalog:prod",
    "domutils": "catalog:prod",
    "htmlparser2": "catalog:prod",
    "jiti": "catalog:prod",
    "oxc-parser": "catalog:prod",
    "pathe": "catalog:prod",
    "playwright": "catalog:prod",
    "site-to-api-runtime": "workspace:*",
    "typescript": "catalog:dev",
    "yaml": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@asyncapi/parser": "catalog:dev",
    "@jridgewell/gen-mapping": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@scalar/openapi-parser": "catalog:dev",
    "micromark": "catalog:dev",
    "micromark-extension-gfm": "catalog:dev"
  }
}
