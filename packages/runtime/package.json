{
  "name": "site-to-api-runtime",
  "type": "module",
  "version": "0.1.1",
  "description": "Small runtime for clients generated by site-to-api: cookie jar, retries, session hooks and HTML extraction. Runs on Node, Bun, browsers and edge workers.",
  "author": "Jatin <agrawaljatin22@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jatinag22/site-to-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinag22/site-to-api.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/jatinag22/site-to-api/issues",
  "keywords": [
    "site-to-api",
    "api-client",
    "cookie-jar",
    "fetch",
    "retry",
    "html-extraction",
    "session"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "css-select": "catalog:prod",
    "domhandler": "catalog:prod",
    "domutils": "catalog:prod",
    "htmlparser2": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "happy-dom": "catalog:dev"
  }
}
