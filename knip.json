{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ]
    },
    "packages/site-to-api": {
      "entry": [
        "bin/*.mjs",
        "test/**/*.ts"
      ]
    },
    "packages/runtime": {},
    "e2e": {
      "entry": [
        "**/*.test.ts",
        "scenarios/*.ts",
        "fixture-site/app/src/main.ts",
        "fixture-site/app/src/widgets/ticker.ts",
        "fixture-site/app/src/widgets/live.ts",
        "fixture-site/app/src/shield/sensor.ts"
      ]
    }
  }
}
